---
import PageLayout from '../../layouts/PageLayout.astro';
---
<PageLayout
  title="Scholastic Activities"
  heroTitle="Scholastic Activities"
  heroBreadcrumb={[{ label: "Activities", href: "/activities" }, { label: "Scholastic Activities", href: "/activities/scholastic" }]}
>
  <div class="max-w-5xl mx-auto px-4 py-14">
    <p class="text-slate-600 text-center max-w-2xl mx-auto mb-12">
      Our scholastic activities are designed to challenge students academically and inspire a love for learning
      that extends well beyond the school walls.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { icon: "🏆", title: "Science Olympiad", desc: "National and state-level science competitions encouraging research and innovation." },
        { icon: "🧮", title: "Maths Olympiad", desc: "Develops problem-solving skills through competitive mathematics programmes." },
        { icon: "🗣️", title: "Debate & Elocution", desc: "Inter-school and intra-school competitions to build communication and critical thinking." },
        { icon: "✍️", title: "Essay & Creative Writing", desc: "Competitions that encourage expression, creativity, and literary skills." },
        { icon: "🧠", title: "Quiz Competitions", desc: "General knowledge and subject-specific quizzes held regularly throughout the year." },
        { icon: "🔬", title: "Science Fair", desc: "Annual science fair where students showcase innovative projects and experiments." },
        { icon: "📰", title: "School Magazine", desc: "Student-run magazine featuring articles, poetry, art, and school news." },
        { icon: "🌐", title: "Inter-School Events", desc: "Participation in district and state-level academic competitions and meets." },
        { icon: "📊", title: "Project Exhibitions", desc: "Annual exhibitions of student research projects across all subjects." },
      ].map((a) => (
        <div class="bg-white rounded-xl border border-slate-100 p-5 shadow-sm hover:shadow-md transition-shadow">
          <div class="text-3xl mb-3">{a.icon}</div>
          <h3 class="font-heading font-bold text-navy text-base mb-1">{a.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{a.desc}</p>
        </div>
      ))}
    </div>
  </div>
</PageLayout>
