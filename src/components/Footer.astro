---
<footer class="bg-navy text-white">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img
            src="/images/michael-logo.webp"
            alt="Catholic Education Society crest"
            width="40"
            height="40"
            loading="lazy"
            class="rounded-full bg-white p-0.5"
          />
          <div>
            <div class="font-heading font-bold text-lg">Michael High School</div>
            <div class="text-white/60 text-xs">Marceline Junior College</div>
          </div>
        </div>
        <p class="text-white/70 text-sm leading-relaxed">
          Managed by Catholic Education Society (CES). Nurturing young minds with quality education since 1979.
        </p>
        <div class="flex gap-3 mt-4">
          <a href="https://www.facebook.com" target="_blank" rel="noopener" class="w-8 h-8 rounded bg-white/10 hover:bg-gold hover:text-navy transition-colors flex items-center justify-center" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="https://www.twitter.com" target="_blank" rel="noopener" class="w-8 h-8 rounded bg-white/10 hover:bg-gold hover:text-navy transition-colors flex items-center justify-center" aria-label="Twitter">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-heading font-bold text-gold mb-4">Quick Links</h3>
        <ul class="space-y-2 text-sm text-white/70">
          <li><a href="/about" class="hover:text-gold transition-colors">About Us</a></li>
          <li><a href="/facilities" class="hover:text-gold transition-colors">Facilities</a></li>
          <li><a href="/accreditation" class="hover:text-gold transition-colors">Accreditation</a></li>
          <li><a href="/fee-structure" class="hover:text-gold transition-colors">Fee Structure</a></li>
          <li><a href="/activities" class="hover:text-gold transition-colors">Activities</a></li>
          <li><a href="/contact" class="hover:text-gold transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="font-heading font-bold text-gold mb-4">Contact Us</h3>
        <ul class="space-y-3 text-sm text-white/70">
          <li class="flex gap-2">
            <svg class="w-4 h-4 text-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Plot No. 249/8, Lal Bahadur Shastri Marg,<br />Kurla West, Mumbai – 400070</span>
          </li>
          <li class="flex gap-2 items-center">
            <svg class="w-4 h-4 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <div>
              <a href="tel:9136693263" class="hover:text-gold transition-colors block">9136693263</a>
              <a href="tel:8104286899" class="hover:text-gold transition-colors block">8104286899</a>
            </div>
          </li>
          <li class="flex gap-2 items-center">
            <svg class="w-4 h-4 text-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:cesmhs1979@gmail.com" class="hover:text-gold transition-colors">cesmhs1979@gmail.com</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-white/10 py-4">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-white/40">
      <span>&copy; {new Date().getFullYear()} Michael High School &amp; Marceline Junior College. Managed by Catholic Education Society (CES).</span>
      <span>
        Designed by&nbsp;<a href="mailto:kadirizaid97@gmail.com" class="text-white/60 hover:text-gold transition-colors font-medium">Zaid Kadiri</a>
      </span>
    </div>
  </div>
</footer>
