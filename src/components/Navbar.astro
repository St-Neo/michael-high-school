---
const navLinks = [
  { label: "Home", href: "/" },
  {
    label: "About Us",
    href: "/about",
    children: [
      { label: "Overview", href: "/about" },
      { label: "Mission & Vision", href: "/about/mission-vision" },
      { label: "General Information", href: "/about/general-information" },
      { label: "Anthem Song", href: "/about/anthem" },
      { label: "Staff", href: "/about/staff" },
      { label: "Committees", href: "/about/committees" },
    ],
  },
  { label: "Facilities", href: "/facilities" },
  { label: "Accreditation", href: "/accreditation" },
  { label: "Fee Structure", href: "/fee-structure" },
  {
    label: "Activities",
    href: "/activities",
    children: [
      { label: "Scholastic Activities", href: "/activities/scholastic" },
      { label: "Co-Scholastic Activities", href: "/activities/co-scholastic" },
      { label: "Departments & Clubs", href: "/activities/departments-clubs" },
    ],
  },
  { label: "Contact Us", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-gold text-navy px-4 py-2 rounded font-semibold z-[100]">
  Skip to main content
</a>

<header class="bg-navy sticky top-0 z-50 shadow-lg">
  <nav class="max-w-7xl mx-auto px-4" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded">
        <img
          src="/images/michael-logo.jpg"
          alt="Catholic Education Society crest"
          width="40"
          height="40"
          class="rounded-full bg-white p-0.5"
        />
        <div class="leading-tight">
          <div class="text-white font-heading font-bold text-base">Michael High School</div>
          <div class="text-white/60 text-xs">Marceline Junior College</div>
        </div>
      </a>

      <!-- Desktop nav -->
      <ul class="hidden lg:flex items-center gap-1" role="list">
        {navLinks.map((link) => (
          <li class="relative group">
            <a
              href={link.href}
              aria-haspopup={link.children ? "true" : undefined}
              class={`px-3 py-2 rounded text-sm font-medium flex items-center gap-1 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold
                ${currentPath === link.href || currentPath.startsWith(link.href + "/")
                  ? "text-gold"
                  : "text-white/90 hover:text-gold"}`}
            >
              {link.label}
              {link.children && (
                <svg aria-hidden="true" class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {link.children && (
              <ul
                role="menu"
                class="absolute top-full left-0 mt-1 bg-white rounded-lg shadow-xl border border-slate-100 py-1 min-w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-opacity transition-visibility duration-200 z-50"
              >
                {link.children.map((child) => (
                  <li role="none">
                    <a
                      href={child.href}
                      role="menuitem"
                      class="block px-4 py-2 text-sm text-slate-700 hover:bg-navy hover:text-white transition-colors focus-visible:outline-none focus-visible:bg-navy focus-visible:text-white"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <!-- Right: phone + hamburger -->
      <div class="flex items-center gap-2">
        <a
          href="tel:9136693263"
          class="hidden md:flex items-center gap-1.5 text-white/80 hover:text-gold text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold rounded px-2 py-1"
          aria-label="Call us: 9136693263"
        >
          <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          9136693263
        </a>

        <button
          id="menu-toggle"
          class="lg:hidden text-white p-2 rounded hover:bg-navy-dark transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-open" aria-hidden="true" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" aria-hidden="true" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 py-3 pb-4" role="navigation" aria-label="Mobile navigation">
      <a href="tel:9136693263" class="flex items-center gap-2 px-3 py-2 text-white/70 text-sm mb-1">
        <svg aria-hidden="true" class="w-4 h-4 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        9136693263
      </a>
      {navLinks.map((link) => (
        <div>
          <a
            href={link.href}
            class="block px-3 py-2 text-white/90 font-medium text-sm hover:text-gold transition-colors focus-visible:outline-none focus-visible:text-gold"
          >
            {link.label}
          </a>
          {link.children && (
            <div class="pl-4 border-l border-white/10 ml-3 mb-1">
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-1.5 text-white/60 text-sm hover:text-gold transition-colors focus-visible:outline-none focus-visible:text-gold"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", !isHidden);
    iconOpen?.classList.toggle("hidden", isHidden ?? false);
    iconClose?.classList.toggle("hidden", !isHidden);
    toggle.setAttribute("aria-expanded", isHidden ? "true" : "false");
  });

  // Close mobile menu on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu?.classList.contains("hidden")) {
      menu?.classList.add("hidden");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    }
  });
</script>
